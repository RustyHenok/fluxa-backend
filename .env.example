APP_NAME=fluxa-backend
APP_MODE=all
HTTP_HOST_PORT=18080
GRPC_HOST_PORT=15051
REDIS_HOST_PORT=16379
HTTP_ADDR=0.0.0.0:8080
GRPC_ADDR=0.0.0.0:50051
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fluxa
REDIS_URL=redis://127.0.0.1/
JWT_SECRET=replace-with-a-32-character-secret-at-minimum
GRPC_AUTH_TOKEN=replace-with-a-32-character-grpc-shared-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=3600
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_REFILL_PER_SEC=2
APP_RATE_LIMIT_CAPACITY=120
APP_RATE_LIMIT_REFILL_PER_SEC=30
JOB_QUEUE_NAME=jobs:queue:default
WORKER_DISPATCH_INTERVAL_MS=3000
WORKER_SCHEDULER_INTERVAL_MS=60000
JOB_QUEUE_BLOCK_TIMEOUT_SECONDS=5
MAX_JOB_ATTEMPTS=5
JOB_LEASE_SECONDS=300
INVITATION_TTL_HOURS=72
DATABASE_MAX_CONNECTIONS=10
STARTUP_MAX_RETRIES=20
STARTUP_RETRY_DELAY_MS=1500
CORS_ALLOW_ORIGIN=*
MAILER_PROVIDER=noop
# SMTP_URL=smtps://smtp.example.com:465 (credentials via URL userinfo)
# MAIL_FROM=Fluxa <no-reply@example.com>
NOTIFY_DISPATCH_INTERVAL_MS=5000
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
REMINDER_DUE_SOON_HOURS=24
REMINDER_DEDUPE_TTL_HOURS=24
ARTIFACT_STORAGE_DIR=data/exports
MAX_ATTACHMENT_SIZE_BYTES=5242880
RETENTION_SWEEP_INTERVAL_HOURS=24
REFRESH_TOKEN_RETENTION_DAYS=30
JOB_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
SAMPLER_INTERVAL_MS=10000
# METRICS_AUTH_TOKEN=optional-bearer-token-for-metrics
